    bash "$CYBERLAB_HOME/modules/client_final_delivery/block_17_4c1_editorial_polisher.sh" "${1:-}"
    ;;
# === END_CYBERLAB_LAYER4C1_EDITORIAL_CASES ===

# === CYBERLAB_BLOCK17_FINAL_DELIVERY_CASES ===
client-final-delivery|block17-final|block17)
    bash "$CYBERLAB_HOME/modules/client_final_delivery/block_17_final_client_delivery.sh" "${1:-}"
    exit $?
    ;;
# === END_CYBERLAB_BLOCK17_FINAL_DELIVERY_CASES ===

# === CYBERLAB_BLOCK16_CASES ===
  block16|unified-audit|client-audit-final-approved)
    CLIENT_NAME="${1:-}"
    TARGET="${2:-}"
    PROFILE="${3:-max-controlled}"

    if [ -z "$CLIENT_NAME" ] || [ -z "$TARGET" ]; then
      echo "[ERRO] Informe cliente e domínio."
      echo 'Uso: cyberlab block16 "Nome do Cliente" dominio.com [perfil]'
      echo 'Uso: cyberlab client-audit-final-approved "Nome do Cliente" dominio.com [perfil]'
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1

    if [ -d "$CYBERLAB_HOME/.venv" ]; then
      source "$CYBERLAB_HOME/.venv/bin/activate"
    fi

    python3 "$CYBERLAB_HOME/modules/block_16_context_bridge.py" \
      "$CLIENT_NAME" \
      "$TARGET" \
      "$PROFILE"

    BLOCK16_RC=$?
    if [ "$BLOCK16_RC" -ne 0 ]; then
        exit "$BLOCK16_RC"
    fi

    echo ""
    echo "[B17] Encadeando entrega final ao cliente..."
    bash "$CYBERLAB_HOME/modules/client_final_delivery/block_17_final_client_delivery.sh"
    exit $?
    ;;
  # === END_CYBERLAB_BLOCK16_CASES ===


  help|"")
