#!/bin/bash

source "${CYBERLAB_HOME:-$HOME/CyberLab}/core/bootstrap.sh"

CMD="$1"
shift || true

case "$CMD" in


  init)
    bash "$CYBERLAB_CORE/init.sh"
    ;;


  run-basic)
    bash "$CYBERLAB_MODULES/ops/run-basic.sh" "$@"
    ;;

  cleanup)
    bash "$CYBERLAB_MODULES/ops/cleanup.sh"
    ;;

  validate-delivery)
    bash "$CYBERLAB_MODULES/ops/validate-delivery.sh" "$@"
    ;;

  export-findings)
    python3 "$CYBERLAB_MODULES/export/findings-export.py"
    ;;

  executive-summary)
    python3 "$CYBERLAB_MODULES/export/executive-summary.py"
    ;;


  intelligence)
    bash "$CYBERLAB_HOME/modules/intelligence/unified-intelligence.sh"
    ;;

  risk)
    python3 "$CYBERLAB_MODULES/risk/risk-engine.py" "$@"
    ;;

  findings)
    python3 "$CYBERLAB_MODULES/findings/findings-engine.py" "$@"
    ;;

  assets)
    python3 "$CYBERLAB_MODULES/assets/asset-engine.py" "$@"
    ;;

  timeline)
    python3 "$CYBERLAB_MODULES/timeline/timeline-engine.py" "$@"
    ;;

  analytics)
    python3 "$CYBERLAB_MODULES/analytics/analytics-engine.py" "$@"
    ;;

  remediation)
    python3 "$CYBERLAB_MODULES/remediation/remediation-engine.py" "$@"
    ;;



  # === CYBERLAB_BLOCK_12_13_CASES ===
  block12|bloco12|intelligence12)
    TARGET="${1:-}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab block12 dominio.com"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1

    if [ -d "$CYBERLAB_HOME/.venv" ]; then
      source "$CYBERLAB_HOME/.venv/bin/activate"
    fi

    echo ""
    echo "=== CyberLab - Bloco 12 Intelligence Engine ==="
    echo "Alvo autorizado: $TARGET"
    echo "Modo: análise local de evidências já coletadas"
    echo ""

    python3 modules/block_12_intelligence.py --target "$TARGET"
    ;;

  block13|bloco13|delivery13)
    TARGET="${1:-}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab block13 dominio.com"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1

    if [ -d "$CYBERLAB_HOME/.venv" ]; then
      source "$CYBERLAB_HOME/.venv/bin/activate"
    fi

    echo ""
    echo "=== CyberLab - Bloco 13 Delivery Enterprise ==="
    echo "Alvo autorizado: $TARGET"
    echo "Modo: geração local de relatórios a partir do Bloco 12"
    echo ""

    python3 modules/block_13_delivery.py --target "$TARGET"
    ;;

  final|final-report|pipeline-final)
    TARGET="${1:-}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab final dominio.com"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1

    if [ -d "$CYBERLAB_HOME/.venv" ]; then
      source "$CYBERLAB_HOME/.venv/bin/activate"
    fi

    echo ""
    echo "============================================================"
    echo " CyberLab - Pipeline Final Controlado"
    echo "============================================================"
    echo " Alvo autorizado: $TARGET"
    echo " Etapas: Bloco 12 -> Bloco 13 -> validação"
    echo " Modo: leitura local de resultados já coletados"
    echo "============================================================"
    echo ""

    echo "[CHECK] Validando sintaxe dos módulos..."
    python3 -m py_compile core/block_12_engine.py || exit 1
    python3 -m py_compile modules/block_12_intelligence.py || exit 1
    python3 -m py_compile core/block_13_report.py || exit 1
    python3 -m py_compile modules/block_13_delivery.py || exit 1
    echo "[OK] Sintaxe validada"
    echo ""

    echo "============================================================"
    echo " Etapa 12 - Intelligence Engine"
    echo "============================================================"
    python3 modules/block_12_intelligence.py --target "$TARGET" || exit 1

    echo ""
    echo "============================================================"
    echo " Etapa 13 - Delivery Enterprise"
    echo "============================================================"
    python3 modules/block_13_delivery.py --target "$TARGET" || exit 1

    LATEST_SCAN="$(ls -td "$CYBERLAB_HOME/results/web/$TARGET"/*/ 2>/dev/null | head -n 1 | sed 's:/*$::')"

    if [ -z "$LATEST_SCAN" ]; then
      echo "[ERRO] Não foi possível localizar a última pasta de scan."
      exit 1
    fi

    BLOCK12_JSON="$LATEST_SCAN/block_12_intelligence/block_12_findings.json"
    BLOCK12_STATUS="$LATEST_SCAN/block_12_intelligence/block_12_status.json"
    BLOCK13_SLA="$LATEST_SCAN/block_13_delivery/sla_timeline.json"
    BLOCK13_STATUS="$LATEST_SCAN/block_13_delivery/block_13_status.json"

    echo ""
    echo "[CHECK] Validando JSONs finais..."

    python3 -m json.tool "$BLOCK12_JSON" > /dev/null || exit 1
    echo "[OK] Bloco 12 findings JSON"

    python3 -m json.tool "$BLOCK12_STATUS" > /dev/null || exit 1
    echo "[OK] Bloco 12 status JSON"

    python3 -m json.tool "$BLOCK13_SLA" > /dev/null || exit 1
    echo "[OK] Bloco 13 SLA JSON"

    python3 -m json.tool "$BLOCK13_STATUS" > /dev/null || exit 1
    echo "[OK] Bloco 13 status JSON"

    echo ""
    echo "============================================================"
    echo " Resumo Final"
    echo "============================================================"

    python3 - << PY2
import json
from pathlib import Path

p = Path("$BLOCK12_JSON")
data = json.loads(p.read_text(encoding="utf-8"))
s = data.get("summary", {})

print("Alvo:", data.get("target"))
print("Pasta do scan:", "$LATEST_SCAN")
print("Total de achados:", s.get("total_findings"))
print("Achados de risco real:", s.get("risk_findings"))
print("Achados de superfície:", s.get("surface_findings"))
print("Score risco real:", s.get("risk_score_total"))
print("Score superfície bruto:", s.get("surface_score_total"))
print("Score superfície ajustado:", s.get("surface_adjusted_score"))
print("Score final calibrado:", s.get("overall_score"))
print("Nível geral:", s.get("risk_level"))
PY2

    echo ""
    echo "Relatórios finais:"
    echo "  Executivo PDF:  $LATEST_SCAN/block_13_delivery/executive_report.pdf"
    echo "  Técnico PDF:    $LATEST_SCAN/block_13_delivery/technical_report.pdf"
    echo "  Remediação PDF: $LATEST_SCAN/block_13_delivery/remediation_plan.pdf"
    echo "  Status:         $LATEST_SCAN/block_13_delivery/block_13_status.json"
    echo ""
    echo "[OK] Pipeline finalizado dentro do dispatcher real do CyberLab."
    ;;
  # === END_CYBERLAB_BLOCK_12_13_CASES ===



  # === CYBERLAB_FULL_ACTIVE_CASE ===
  full-active|active-full|max-active)
    TARGET="${1:-}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab full-active dominio.com"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1

    if [ -d "$CYBERLAB_HOME/.venv" ]; then
      source "$CYBERLAB_HOME/.venv/bin/activate"
    fi

    echo ""
    echo "============================================================"
    echo " CyberLab - Full Active Pipeline Controlado"
    echo "============================================================"
    echo " Alvo autorizado: $TARGET"
    echo " Modo: active integrado ao fluxo completo"
    echo " Controle: escopo, logs, evidências e relatório final"
    echo "============================================================"
    echo ""

    echo "[CHECK] Validando dispatcher e módulos principais..."
    bash -n bin/cyberlab || exit 1
    bash -n modules/active/active.sh || exit 1
    python3 -m py_compile core/block_12_engine.py || exit 1
    python3 -m py_compile modules/block_12_intelligence.py || exit 1
    python3 -m py_compile core/block_13_report.py || exit 1
    python3 -m py_compile modules/block_13_delivery.py || exit 1
    echo "[OK] Validação inicial concluída"
    echo ""

    echo "============================================================"
    echo " 01/13 Health"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" health || exit 1

    echo ""
    echo "============================================================"
    echo " 02/13 Validate All"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" validate-all || exit 1

    echo ""
    echo "============================================================"
    echo " 03/13 Web Scan"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" web "$TARGET" || exit 1

    echo ""
    echo "============================================================"
    echo " 04/13 Active Mode"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" active run "LabInterno" "$TARGET" active || exit 1

    echo ""
    echo "============================================================"
    echo " 04B/13 Sincronizando evidências do Active"
    echo "============================================================"

    LATEST_SCAN_ACTIVE="$(ls -td "$CYBERLAB_HOME/results/web/$TARGET"/*/ 2>/dev/null | head -n 1 | sed 's:/*$::')"
    TARGET_SLUG="$(echo "$TARGET" | tr '.:' '--')"
    LATEST_ACTIVE="$(ls -td "$CYBERLAB_HOME/results/active/$TARGET_SLUG"* 2>/dev/null | head -n 1)"

    if [ -n "$LATEST_SCAN_ACTIVE" ] && [ -n "$LATEST_ACTIVE" ]; then
      mkdir -p "$LATEST_SCAN_ACTIVE/08-evidence/active"
      cp -a "$LATEST_ACTIVE" "$LATEST_SCAN_ACTIVE/08-evidence/active/active-output" 2>/dev/null || true
      echo "[OK] Active sincronizado em: $LATEST_SCAN_ACTIVE/08-evidence/active"
    else
      echo "[AVISO] Saída active não localizada para sincronização automática."
      echo "[AVISO] O fluxo continuará sem quebrar o pipeline."
    fi

    # === CYBERLAB_ACTIVE_OUTPUT_SYNC ===

    echo ""
    echo "============================================================"
    echo " 05/13 Detect"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" detect "$TARGET" || true

    echo ""
    echo "============================================================"
    echo " 06/13 Threat"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" threat "$TARGET" || true

    echo ""
    echo "============================================================"
    echo " 07/13 Correlate"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" correlate "$TARGET" || true

    echo ""
    echo "============================================================"
    echo " 08/13 Findings"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" findings "$TARGET" || true

    echo ""
    echo "============================================================"
    echo " 09/13 Risk"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" risk "$TARGET" || true

    echo ""
    echo "============================================================"
    echo " 10/13 Assets"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" assets "$TARGET" || true

    echo ""
    echo "============================================================"
    echo " 11/13 Timeline / Analytics / Remediation"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" timeline "$TARGET" || true
    "$CYBERLAB_HOME/bin/cyberlab" analytics "$TARGET" || true
    "$CYBERLAB_HOME/bin/cyberlab" remediation "$TARGET" || true

    echo ""
    echo "============================================================"
    echo " 12/13 Bloco 12 + Bloco 13"
    echo "============================================================"
    "$CYBERLAB_HOME/bin/cyberlab" final "$TARGET" || exit 1

    LATEST_SCAN="$(ls -td "$CYBERLAB_HOME/results/web/$TARGET"/*/ 2>/dev/null | head -n 1 | sed 's:/*$::')"

    if [ -z "$LATEST_SCAN" ]; then
      echo "[ERRO] Não foi possível localizar a última pasta de scan."
      exit 1
    fi

    echo ""
    echo "============================================================"
    echo " 13/13 Validação Final"
    echo "============================================================"

    python3 -m json.tool "$LATEST_SCAN/block_12_intelligence/block_12_findings.json" > /dev/null && echo "[OK] Bloco 12 findings"
    python3 -m json.tool "$LATEST_SCAN/block_12_intelligence/block_12_status.json" > /dev/null && echo "[OK] Bloco 12 status"
    python3 -m json.tool "$LATEST_SCAN/block_13_delivery/sla_timeline.json" > /dev/null && echo "[OK] Bloco 13 SLA"
    python3 -m json.tool "$LATEST_SCAN/block_13_delivery/block_13_status.json" > /dev/null && echo "[OK] Bloco 13 status"

    echo ""
    echo "Relatórios finais:"
    echo "  Executivo PDF:  $LATEST_SCAN/block_13_delivery/executive_report.pdf"
    echo "  Técnico PDF:    $LATEST_SCAN/block_13_delivery/technical_report.pdf"
    echo "  Remediação PDF: $LATEST_SCAN/block_13_delivery/remediation_plan.pdf"
    echo ""
    echo "[OK] Full Active Pipeline finalizado."
    ;;
  # === END_CYBERLAB_FULL_ACTIVE_CASE ===



  # === CYBERLAB_BLOCK_14_CASES ===
  block14|bloco14|validation14|validate-findings)
    TARGET="${1:-}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab block14 dominio.com"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1

    if [ -d "$CYBERLAB_HOME/.venv" ]; then
      source "$CYBERLAB_HOME/.venv/bin/activate"
    fi

    echo ""
    echo "=== CyberLab - Bloco 14 Validation Intelligence ==="
    echo "Alvo autorizado: $TARGET"
    echo "Modo: validação contextual local"
    echo ""

    python3 modules/block_14_validation.py --target "$TARGET"
    ;;

  validated-final|final-validated|delivery-validated)
    TARGET="${1:-}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab validated-final dominio.com"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1

    if [ -d "$CYBERLAB_HOME/.venv" ]; then
      source "$CYBERLAB_HOME/.venv/bin/activate"
    fi

    echo ""
    echo "============================================================"
    echo " CyberLab - Final Validado"
    echo "============================================================"
    echo " Alvo autorizado: $TARGET"
    echo " Etapas: Bloco 12 -> Bloco 13 -> Bloco 14"
    echo "============================================================"
    echo ""

    "$CYBERLAB_HOME/bin/cyberlab" final "$TARGET" || exit 1
    "$CYBERLAB_HOME/bin/cyberlab" block14 "$TARGET" || exit 1

    LATEST_SCAN="$(ls -td "$CYBERLAB_HOME/results/web/$TARGET"/*/ 2>/dev/null | head -n 1 | sed 's:/*$::')"

    echo ""
    echo "Relatórios finais:"
    echo "  Executivo PDF:      $LATEST_SCAN/block_13_delivery/executive_report.pdf"
    echo "  Técnico PDF:        $LATEST_SCAN/block_13_delivery/technical_report.pdf"
    echo "  Remediação PDF:     $LATEST_SCAN/block_13_delivery/remediation_plan.pdf"
    echo "  Validação Bloco 14: $LATEST_SCAN/block_14_validation/block_14_validation_report.pdf"
    echo "  Resumo Cliente 14:  $LATEST_SCAN/block_14_validation/block_14_client_summary.md"
    echo ""
    echo "[OK] Final validado concluído."
    ;;

  full-active-validated|validated-full-active|max-active-validated)
    TARGET="${1:-}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab full-active-validated dominio.com"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1

    if [ -d "$CYBERLAB_HOME/.venv" ]; then
      source "$CYBERLAB_HOME/.venv/bin/activate"
    fi

    echo ""
    echo "============================================================"
    echo " CyberLab - Full Active Validado"
    echo "============================================================"
    echo " Alvo autorizado: $TARGET"
    echo " Etapas: full-active -> Bloco 14 Validation Intelligence"
    echo "============================================================"
    echo ""

    "$CYBERLAB_HOME/bin/cyberlab" full-active "$TARGET" || exit 1
    "$CYBERLAB_HOME/bin/cyberlab" block14 "$TARGET" || exit 1

    LATEST_SCAN="$(ls -td "$CYBERLAB_HOME/results/web/$TARGET"/*/ 2>/dev/null | head -n 1 | sed 's:/*$::')"

    echo ""
    echo "============================================================"
    echo " Validação final dos artefatos"
    echo "============================================================"

    python3 -m json.tool "$LATEST_SCAN/block_12_intelligence/block_12_findings.json" > /dev/null && echo "[OK] Bloco 12 findings"
    python3 -m json.tool "$LATEST_SCAN/block_12_intelligence/block_12_status.json" > /dev/null && echo "[OK] Bloco 12 status"
    python3 -m json.tool "$LATEST_SCAN/block_13_delivery/sla_timeline.json" > /dev/null && echo "[OK] Bloco 13 SLA"
    python3 -m json.tool "$LATEST_SCAN/block_13_delivery/block_13_status.json" > /dev/null && echo "[OK] Bloco 13 status"
    python3 -m json.tool "$LATEST_SCAN/block_14_validation/block_14_validated_findings.json" > /dev/null && echo "[OK] Bloco 14 validated findings"
    python3 -m json.tool "$LATEST_SCAN/block_14_validation/block_14_insights.json" > /dev/null && echo "[OK] Bloco 14 insights"
    python3 -m json.tool "$LATEST_SCAN/block_14_validation/block_14_status.json" > /dev/null && echo "[OK] Bloco 14 status"

    echo ""
    echo "Relatórios finais:"
    echo "  Executivo PDF:      $LATEST_SCAN/block_13_delivery/executive_report.pdf"
    echo "  Técnico PDF:        $LATEST_SCAN/block_13_delivery/technical_report.pdf"
    echo "  Remediação PDF:     $LATEST_SCAN/block_13_delivery/remediation_plan.pdf"
    echo "  Validação Bloco 14: $LATEST_SCAN/block_14_validation/block_14_validation_report.pdf"
    echo "  Resumo Cliente 14:  $LATEST_SCAN/block_14_validation/block_14_client_summary.md"
    echo ""
    echo "[OK] Full Active Validado finalizado."
    ;;
  # === END_CYBERLAB_BLOCK_14_CASES ===



  # === CYBERLAB_BLOCK_15_CASES ===
  block15|bloco15|validate-impact|impact-validation)
    TARGET="${1:-}"
    MODE="${2:-controlled}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab block15 dominio.com [controlled|active-plus|max-controlled]"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1

    if [ -d "$CYBERLAB_HOME/.venv" ]; then
      source "$CYBERLAB_HOME/.venv/bin/activate"
    fi

    echo ""
    echo "=== CyberLab - Bloco 15 Controlled Offensive Validation ==="
    echo "Alvo autorizado: $TARGET"
    echo "Modo: $MODE"
    echo "Controle: escopo, rate limit, logs e validações seguras"
    echo ""

    python3 modules/block_15_validation.py --target "$TARGET" --mode "$MODE"
    ;;

  active-plus)
    TARGET="${1:-}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab active-plus dominio.com"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1

    if [ -d "$CYBERLAB_HOME/.venv" ]; then
      source "$CYBERLAB_HOME/.venv/bin/activate"
    fi

    echo ""
    echo "============================================================"
    echo " CyberLab - Active Plus Controlado"
    echo "============================================================"
    echo " Alvo autorizado: $TARGET"
    echo " Etapas: full-active -> block14 -> block15 active-plus"
    echo "============================================================"
    echo ""

    "$CYBERLAB_HOME/bin/cyberlab" full-active "$TARGET" || exit 1
    "$CYBERLAB_HOME/bin/cyberlab" block14 "$TARGET" || exit 1
    "$CYBERLAB_HOME/bin/cyberlab" block15 "$TARGET" active-plus || exit 1

    LATEST_SCAN="$(ls -td "$CYBERLAB_HOME/results/web/$TARGET"/*/ 2>/dev/null | head -n 1 | sed 's:/*$::')"

    echo ""
    echo "[OK] Active Plus finalizado."
    echo "Relatório Bloco 15: $LATEST_SCAN/block_15_controlled_validation/block_15_impact_report.pdf"
    ;;

  full-offensive-controlled|full-controlled|max-controlled)
    TARGET="${1:-}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab full-offensive-controlled dominio.com"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1

    if [ -d "$CYBERLAB_HOME/.venv" ]; then
      source "$CYBERLAB_HOME/.venv/bin/activate"
    fi

    echo ""
    echo "============================================================"
    echo " CyberLab - Full Offensive Controlled"
    echo "============================================================"
    echo " Alvo autorizado: $TARGET"
    echo " Fluxo: full-active -> Bloco 14 -> Bloco 15"
    echo " Segurança: sem brute force, sem bypass, sem payload destrutivo"
    echo "============================================================"
    echo ""

    echo "[CHECK] Validando módulos..."
    bash -n bin/cyberlab || exit 1
    bash -n modules/active/active.sh || exit 1
    python3 -m py_compile core/block_12_engine.py || exit 1
    python3 -m py_compile modules/block_12_intelligence.py || exit 1
    python3 -m py_compile core/block_14_engine.py || exit 1
    python3 -m py_compile modules/block_14_validation.py || exit 1
    python3 -m py_compile core/block_15_engine.py || exit 1
    python3 -m py_compile modules/block_15_validation.py || exit 1
    python3 -m py_compile core/block_13_report.py || exit 1
    python3 -m py_compile modules/block_13_delivery.py || exit 1
    echo "[OK] Módulos validados"
    echo ""

    "$CYBERLAB_HOME/bin/cyberlab" full-active "$TARGET" || exit 1
    "$CYBERLAB_HOME/bin/cyberlab" block14 "$TARGET" || exit 1
    "$CYBERLAB_HOME/bin/cyberlab" block15 "$TARGET" max-controlled || exit 1

    LATEST_SCAN="$(ls -td "$CYBERLAB_HOME/results/web/$TARGET"/*/ 2>/dev/null | head -n 1 | sed 's:/*$::')"

    echo ""
    echo "============================================================"
    echo " Validação final dos artefatos"
    echo "============================================================"

    python3 -m json.tool "$LATEST_SCAN/block_12_intelligence/block_12_findings.json" > /dev/null && echo "[OK] Bloco 12 findings"
    python3 -m json.tool "$LATEST_SCAN/block_12_intelligence/block_12_status.json" > /dev/null && echo "[OK] Bloco 12 status"
    python3 -m json.tool "$LATEST_SCAN/block_13_delivery/block_13_status.json" > /dev/null && echo "[OK] Bloco 13 status"
    python3 -m json.tool "$LATEST_SCAN/block_14_validation/block_14_validated_findings.json" > /dev/null && echo "[OK] Bloco 14 validated"
    python3 -m json.tool "$LATEST_SCAN/block_14_validation/block_14_status.json" > /dev/null && echo "[OK] Bloco 14 status"
    python3 -m json.tool "$LATEST_SCAN/block_15_controlled_validation/block_15_validations.json" > /dev/null && echo "[OK] Bloco 15 validations"
    python3 -m json.tool "$LATEST_SCAN/block_15_controlled_validation/block_15_confirmed_findings.json" > /dev/null && echo "[OK] Bloco 15 confirmed"
    python3 -m json.tool "$LATEST_SCAN/block_15_controlled_validation/block_15_status.json" > /dev/null && echo "[OK] Bloco 15 status"

    echo ""
    echo "Relatórios finais:"
    echo "  Executivo PDF:        $LATEST_SCAN/block_13_delivery/executive_report.pdf"
    echo "  Técnico PDF:          $LATEST_SCAN/block_13_delivery/technical_report.pdf"
    echo "  Remediação PDF:       $LATEST_SCAN/block_13_delivery/remediation_plan.pdf"
    echo "  Validação Bloco 14:   $LATEST_SCAN/block_14_validation/block_14_validation_report.pdf"
    echo "  Impacto Bloco 15:     $LATEST_SCAN/block_15_controlled_validation/block_15_impact_report.pdf"
    echo "  Resumo Cliente B15:   $LATEST_SCAN/block_15_controlled_validation/block_15_client_summary.md"
    echo "  Testes Manuais B15:   $LATEST_SCAN/block_15_controlled_validation/block_15_manual_tests.md"
    echo ""
    echo "[OK] Full Offensive Controlled finalizado."
    ;;
  # === END_CYBERLAB_BLOCK_15_CASES ===



  # === CYBERLAB_TOOLS_STACK_CASES ===
  tools-check|offensive-tools-check)
    bash "$CYBERLAB_HOME/tools/offensive_tools_check.sh"
    ;;

  tools-install|install-offensive-tools)
    bash "$CYBERLAB_HOME/tools/installers/install_offensive_stack.sh"
    ;;
  # === END_CYBERLAB_TOOLS_STACK_CASES ===



  # === CYBERLAB_AUDIT_TOOLS_CASE ===
  audit-tools|tools-audit)
    TARGET="${1:-}"
    PROFILE="${2:-safe}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab audit-tools dominio.com [safe|active|active-plus|max-controlled]"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1
    source "$CYBERLAB_HOME/.venv/bin/activate" 2>/dev/null || true

    python3 "$CYBERLAB_HOME/tools/orchestrator/tool_runner.py" \
      --target "$TARGET" \
      --profile "$PROFILE"
    ;;

  audit-tools-approved|tools-audit-approved)
    TARGET="${1:-}"
    PROFILE="${2:-active-plus}"

    if [ -z "$TARGET" ]; then
      echo "[ERRO] Informe o domínio autorizado."
      echo "Uso: cyberlab audit-tools-approved dominio.com [active-plus|max-controlled]"
      exit 1
    fi

    cd "$CYBERLAB_HOME" || exit 1
    source "$CYBERLAB_HOME/.venv/bin/activate" 2>/dev/null || true

    python3 "$CYBERLAB_HOME/tools/orchestrator/tool_runner.py" \
      --target "$TARGET" \
      --profile "$PROFILE" \
      --approve
    ;;
  # === END_CYBERLAB_AUDIT_TOOLS_CASE ===



  # === CYBERLAB_CLEANUP_LAYER2_CASES ===
cleanup-obsolete)
    bash "$CYBERLAB_HOME/modules/core/cleanup-obsolete.sh" "${1:-dry-run}"
    ;;
cleanup-status)
    bash "$CYBERLAB_HOME/modules/core/cleanup-status.sh"
    ;;
# === END_CYBERLAB_CLEANUP_LAYER2_CASES ===


    # === CYBERLAB_LAYER3_AUDIT_CONTEXT_CASE ===
    audit-context|context)
        bash "$CYBERLAB_HOME/modules/core/audit-context.sh" "$@"
        exit $?
        ;;
    # === END_CYBERLAB_LAYER3_AUDIT_CONTEXT_CASE ===

    
# === CYBERLAB_LAYER4C1_EDITORIAL_CASES ===
