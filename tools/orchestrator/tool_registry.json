      "nuclei_controlled",
      "sqlmap_check",
      "masscan_webports_controlled",
      "metasploit_check"
    ]
  },
  "tools": {
    "nmap_safe": {
      "binary": "nmap",
      "category": "network",
      "risk": "low",
      "requires_approval": false,
      "timeout": 600,
      "command": "nmap -sV --version-light -T2 --top-ports 100 --reason -oA {out}/nmap_safe {target}"
    },
    "nikto_safe": {
      "binary": "nikto",
      "category": "web",
      "risk": "medium",
      "requires_approval": false,
      "timeout": 900,
      "command": "nikto -h https://{target} -nointeractive -output {out}/nikto_safe.txt"
    },
    "wapiti_light": {
      "binary": "wapiti",
      "category": "web",
      "risk": "medium",
      "requires_approval": false,
      "timeout": 1800,
      "command": "wapiti -u https://{target} --scope domain -d 2 --max-scan-time 900 --max-links-per-page 30 -f json -o {out}/wapiti_light.json"
    },
    "zap_baseline": {
      "binary": "/home/ph/CyberLab/tools/bin/zap.sh",
      "category": "web",
      "risk": "medium",
      "requires_approval": false,
      "timeout": 1080,
      "command": "timeout 900s {root}/tools/bin/zap.sh -cmd -quickurl https://{target} -quickout {out}/zap_baseline.html"
    },
    "ffuf_controlled": {
      "binary": "ffuf",
      "category": "web-discovery",
      "risk": "medium",
      "requires_approval": false,
      "timeout": 1200,
      "command": "ffuf -u https://{target}/FUZZ -w {root}/tools/wordlists/SecLists/Discovery/Web-Content/common.txt -rate 15 -t 8 -timeout 10 -mc 200,204,301,302,307,308,401,403,405 -fc 404 -ac -of json -o {out}/ffuf_controlled.json"
    },
    "gobuster_controlled": {
      "binary": "gobuster",
      "category": "web-discovery",
      "risk": "medium",
      "requires_approval": false,
      "timeout": 1200,
      "command": "gobuster dir -u https://{target} -w {root}/tools/wordlists/SecLists/Discovery/Web-Content/common.txt -t 8 --delay 100ms -k -b 404,429 -s 200,204,301,302,307,308,401,403,405 -o {out}/gobuster_controlled.txt"
    },
    "sqlmap_check": {
      "binary": "sqlmap",
      "category": "injection-validation",
      "risk": "high",
      "requires_approval": true,
      "timeout": 1200,
      "command": "sqlmap -u https://{target}/ --batch --level 1 --risk 1 --smart --crawl=1 --forms --output-dir={out}/sqlmap --flush-session"
    },
    "metasploit_check": {
      "binary": "msfconsole",
      "category": "exploit-framework",
      "risk": "high",
      "requires_approval": true,
      "timeout": 900,
      "command": "msfconsole -q -x 'db_status; exit' > {out}/metasploit_check.txt"
    },
    "gowitness_snapshot": {
      "binary": "gowitness",
      "category": "visual-evidence",
      "risk": "low",
      "requires_approval": false,
      "timeout": 1200,
      "command": "CHROME_BIN=\"$(command -v google-chrome || command -v chromium || command -v chromium-browser)\"; if [ -z \"$CHROME_BIN\" ]; then echo \"[ERRO] Chrome/Chromium não localizado para o gowitness.\"; exit 1; fi; mkdir -p {out}/screenshots; GW_RC=1; for GW_ATTEMPT in 1 2; do echo \"[INFO] gowitness tentativa $GW_ATTEMPT/2\"; gowitness scan single --url \"https://{target}\" --chrome-path \"$CHROME_BIN\" --screenshot-path {out}/screenshots --write-jsonl --write-jsonl-file {out}/gowitness_snapshot.jsonl && GW_RC=0 && break; GW_RC=$?; echo \"[WARN] gowitness falhou na tentativa $GW_ATTEMPT com rc=$GW_RC\"; sleep 3; done; exit \"$GW_RC\""
    },
    "wpscan_passive": {
      "binary": "wpscan",
      "category": "cms-wordpress",
      "risk": "medium",
      "requires_approval": false,
      "timeout": 1800,
      "command": "wpscan --url \"https://{target}/\" --stealthy --format json --output {out}/wpscan_passive.json --no-update"
    },
    "masscan_webports_controlled": {
      "binary": "masscan",
      "category": "network-fast-discovery",
      "risk": "medium",
      "requires_approval": true,
      "timeout": 900,
      "command": "TARGET_IP=\"$(getent ahostsv4 {target} | awk 'NR==1{{print $1}}')\"; if [ -z \"$TARGET_IP\" ]; then echo \"[SKIP] Não foi possível resolver IPv4 para {target}\" > {out}/masscan_webports_controlled.txt; exit 0; fi; echo \"[INFO] target={target} ip=$TARGET_IP\" > {out}/masscan_webports_controlled.txt; masscan \"$TARGET_IP\" -p80,443,8080,8443,8000,8888 --rate 100 --wait 5 -oJ {out}/masscan_webports_controlled.json >> {out}/masscan_webports_controlled.txt 2>&1"
    },
    "httpx_fingerprint": {
      "binary": "httpx",
      "category": "web-fingerprint",
      "risk": "low",
      "requires_approval": false,
      "timeout": 900,
      "command": "printf 'https://{target}\\nhttp://{target}\\n' | httpx -silent -status-code -title -tech-detect -server -cdn -location -follow-redirects -json -rl 5 -retries 1 -timeout 10 -o {out}/httpx_fingerprint.json"
    },
    "katana_crawl_light": {
      "binary": "katana",
      "category": "url-discovery",
      "risk": "medium",
      "requires_approval": false,
      "timeout": 1200,
      "command": "katana -u https://{target} -d 2 -silent -json -jc -kf all -fx -rl 3 -c 5 -timeout 10 -o {out}/katana_crawl_light.json"
    },
    "nuclei_controlled": {
      "binary": "nuclei",
      "category": "vulnerability-scanner",
      "risk": "medium",
      "requires_approval": true,
      "timeout": 1800,
      "command": "nuclei -u https://{target} -severity low,medium,high,critical -tags exposure,misconfig,cve,oast,token,secret,auth,redirect,headers,takeover -etags dos,fuzz,bruteforce,intrusive -jsonl -silent -rl 15 -c 15 -retries 0 -timeout 6 -duc -ni -o {out}/nuclei_controlled.json"
    }
  }
}